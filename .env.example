# ==============================================================================
# LumenLend Environment Configuration
# ==============================================================================
# NOTE: Copy this file to .env or .env.local and populate the required values.
# NEVER commit actual private keys or secrets into source control!
# ==============================================================================

# Stellar Network Configuration
# Options: testnet | futurenet | standalone | mainnet
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Deployer / Admin Credentials (for local scripts only - never in frontend)
ADMIN_SECRET_KEY=
ORACLE_ADMIN_SECRET_KEY=

# Asset Token Contract IDs (Soroban native / SAC contracts)
# Testnet default SAC contracts
USDC_CONTRACT_ID=CAQCFV44SC27F76B6J5SQ5F5Z2NV74G565TJX5NWLX2P7X76HGXUSDC7
XLM_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCXLM

# Protocol Contract IDs (Populated after running `pnpm deploy:testnet`)
LENDING_POOL_CONTRACT_ID=
COLLATERAL_VAULT_CONTRACT_ID=
LIQUIDATION_ENGINE_CONTRACT_ID=
ORACLE_MANAGER_CONTRACT_ID=
INTEREST_RATE_MODEL_CONTRACT_ID=

# Indexer & Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumenlend
INDEXER_PORT=4000
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_START_LEDGER=0

# Frontend Next.js Public Configuration
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_USDC_CONTRACT_ID=CAQCFV44SC27F76B6J5SQ5F5Z2NV74G565TJX5NWLX2P7X76HGXUSDC7
NEXT_PUBLIC_XLM_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCXLM
NEXT_PUBLIC_LENDING_POOL_CONTRACT_ID=
NEXT_PUBLIC_COLLATERAL_VAULT_CONTRACT_ID=
NEXT_PUBLIC_LIQUIDATION_ENGINE_CONTRACT_ID=
NEXT_PUBLIC_ORACLE_MANAGER_CONTRACT_ID=
NEXT_PUBLIC_INTEREST_RATE_MODEL_CONTRACT_ID=
